<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ====================================================== -->
    <!-- Properties                                              -->
    <!-- ====================================================== -->
    <property name="LOG_PATH" value="logs" />

    <!-- ====================================================== -->
    <!-- CONSOLE appender                                        -->
    <!-- Dev: human-readable, colored, includes traceId + actor -->
    <!-- Non-dev: JSON via LogstashEncoder                       -->
    <!-- ====================================================== -->
    <springProfile name="dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%cyan(%thread)] [traceId=%yellow(%X{traceId})] [actor=%magenta(%X{actor})] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
    </springProfile>

    <springProfile name="!dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>actor</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
                <includeMdcKeyName>httpMethod</includeMdcKeyName>
                <includeMdcKeyName>httpPath</includeMdcKeyName>
                <includeMdcKeyName>httpStatus</includeMdcKeyName>
            </encoder>
        </appender>
    </springProfile>

    <!-- ====================================================== -->
    <!-- APP_FILE — rolling by date+size, 30 days               -->
    <!-- ====================================================== -->
    <appender name="APP_FILE_RAW" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/application.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>actor</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>httpMethod</includeMdcKeyName>
            <includeMdcKeyName>httpPath</includeMdcKeyName>
            <includeMdcKeyName>httpStatus</includeMdcKeyName>
            <includeMdcKeyName>auctionId</includeMdcKeyName>
            <includeMdcKeyName>bidId</includeMdcKeyName>
            <includeMdcKeyName>eventType</includeMdcKeyName>
            <includeMdcKeyName>errorCode</includeMdcKeyName>
            <includeMdcKeyName>operation</includeMdcKeyName>
        </encoder>
    </appender>

    <appender name="APP_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
        <appender-ref ref="APP_FILE_RAW" />
    </appender>

    <!-- ====================================================== -->
    <!-- AUDIT_FILE — rolling by date+size, 90 days compliance   -->
    <!-- ====================================================== -->
    <appender name="AUDIT_FILE_RAW" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/audit.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>9GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>actor</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
        </encoder>
    </appender>

    <appender name="AUDIT_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
        <appender-ref ref="AUDIT_FILE_RAW" />
    </appender>

    <!-- ====================================================== -->
    <!-- BACKUP_FILE — rolling by date+size, 90 days            -->
    <!-- ====================================================== -->
    <appender name="BACKUP_FILE_RAW" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/backup.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/backup.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>9GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>actor</includeMdcKeyName>
            <includeMdcKeyName>operation</includeMdcKeyName>
        </encoder>
    </appender>

    <appender name="BACKUP_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
        <appender-ref ref="BACKUP_FILE_RAW" />
    </appender>

    <!-- ====================================================== -->
    <!-- SECURITY_FILE — rolling by date+size, 90 days           -->
    <!-- ====================================================== -->
    <appender name="SECURITY_FILE_RAW" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/security.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/security.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>4500MB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>actor</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
        </encoder>
    </appender>

    <appender name="SECURITY_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
        <appender-ref ref="SECURITY_FILE_RAW" />
    </appender>

    <!-- ====================================================== -->
    <!-- Logger routing                                          -->
    <!-- ====================================================== -->

    <!-- Audit logger → AUDIT_FILE only (additivity=false prevents double-logging) -->
    <logger name="com.example.daugia.common.audit" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_FILE" />
    </logger>

    <!-- Backup logger → BACKUP_FILE only -->
    <logger name="com.example.daugia.backup" level="INFO" additivity="false">
        <appender-ref ref="BACKUP_FILE" />
    </logger>

    <!-- Auth filter (e.g. RateLimitFilter, JwtAuthFilter) → SECURITY_FILE + CONSOLE, WARN+ only -->
    <logger name="com.example.daugia.auth.filter" level="WARN" additivity="false">
        <appender-ref ref="SECURITY_FILE" />
        <appender-ref ref="CONSOLE" />
    </logger>

    <!-- Auth package (services, controllers) → SECURITY_FILE only, WARN+ -->
    <logger name="com.example.daugia.auth" level="WARN" additivity="false">
        <appender-ref ref="SECURITY_FILE" />
    </logger>

    <!-- Suppress framework noise -->
    <logger name="org.hibernate.SQL" level="WARN" />
    <logger name="org.hibernate.type.descriptor.sql" level="WARN" />
    <logger name="org.springframework.web" level="WARN" />
    <logger name="org.springframework.security" level="WARN" />
    <logger name="io.lettuce" level="WARN" />
    <logger name="org.springframework.data.redis" level="WARN" />

    <!-- ====================================================== -->
    <!-- Profile-specific root config                            -->
    <!-- ====================================================== -->

    <springProfile name="dev">
        <!-- Application classes at DEBUG in dev -->
        <logger name="com.example.daugia" level="DEBUG" />
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="APP_FILE" />
        </root>
    </springProfile>

    <springProfile name="!dev">
        <!-- Application classes at INFO in prod -->
        <logger name="com.example.daugia" level="INFO" />
        <root level="INFO">
            <appender-ref ref="APP_FILE" />
        </root>
    </springProfile>

</configuration>